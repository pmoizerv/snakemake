configfile: "config/config.yaml"

SAMPLES = [
    line.strip()
    for line in open("samples.tsv")
    if line.strip() and not line.startswith("sample")
]

INTERVALS = [
    f"{i:04d}"
    for i in range(1, config["intervals"]["windows"] + 1)
]


include: "rules/qc.smk"
include: "rules/trim.smk"
include: "rules/mapping.smk"
include: "rules/gvcf.smk"
include: "rules/jointgenotyping.smk"

rule all:
    input:
        expand(
            "results/05_mapping_stats/{sample}.flagstat.txt",
            sample=SAMPLES),
        expand(
            "results/05_mapping_stats/{sample}.idxstats.txt",
            sample=SAMPLES),
        expand(
            "results/05_mapping_stats/{sample}.samstats.txt",
            sample=SAMPLES),
        "results/00_fastqc_raw/multiqc_report.html"
